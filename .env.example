# ─────────────────────────────────────────────
# Telegram Activity Bot — Muhit o'zgaruvchilari
# ─────────────────────────────────────────────
# Bu faylni .env deb nomlang va qiymatlarni to'ldiring.

# BotFather dan olingan bot token
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Admin Telegram ID (faqat siz). @userinfobot orqali bilib olish mumkin
ADMIN_ID=123456789

# Kanalingizning raqamli ID'si (masalan: -1001234567890)
CHANNEL_ID=-1001234567890

# Muhokama guruhining (discussion group) raqamli ID'si
CHAT_ID=-1001234567891
