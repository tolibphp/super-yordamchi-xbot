[Unit]
Description=Telegram Activity & Winner Bot
After=network.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/opt/telegram-activity-bot
ExecStart=/opt/telegram-activity-bot/venv/bin/python main.py
Restart=always
RestartSec=5
EnvironmentFile=/opt/telegram-activity-bot/.env

# Xavfsizlik sozlamalari
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
